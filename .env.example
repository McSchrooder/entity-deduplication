DEDUPE_GUESTS_PARQUET=data/real/guests.parquet
DEDUPE_PERSON_MAP_PARQUET=data/real/person_map.parquet

# backends
MONGO_URI=mongodb://mongotUser:mongotPassword@localhost:27018/?authSource=admin&directConnection=true
# point the harness at any pre-ingested cluster by overriding these
#MONGO_DB=dedupe_base
#MONGO_COLLECTION=documents
#MONGO_VECTOR_INDEX=bgem3_vector_index
#MONGO_LEXICAL_INDEX=dynamic_text_index
