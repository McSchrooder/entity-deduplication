# LLM scorer can be any OpenAI-compatible endpoint (vLLM, ollama, openai)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-8B-FP8
LLM_API_KEY=empty
